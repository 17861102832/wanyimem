{
  // 万忆中枢 MCP 接入示例（v1.1）
  // -------------------------------------------------------------
  // 环境变量 key 支持「中文优先、英文兜底」两种写法：
  //   中文名（旧）：万忆中枢_STORE_DIR
  //   英文名（新，推荐）：WANYI_STORE_DIR
  // 两者任填其一即可，同时填则中文优先。本示例用推荐的新写法。
  // -------------------------------------------------------------
  "mcpServers": {
    "wanyi": {
      // 建议用解释器绝对路径（Windows 常见：C:/Python312/python.exe）
      // 或先 `pip install wanyimem` 后直接用 console 入口：wanyi
      // 裸 `python` 依赖 PATH，部分系统是 python3，可能解析失败。
      "command": "python",
      "args": ["-m", "wanyi.memory_core"],
      "env": {
        "WANYI_STORE_DIR": "C:/path/to/your/memory",
        "WANYI_USER_PROFILE": "C:/path/to/user_profile.md",
        "WANYI_TRADING_ANCHOR": "C:/path/to/trading_anchor.md",
        "HF_ENDPOINT": "https://hf-mirror.com",
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUTF8": "1"
      }
    }
  }
}
